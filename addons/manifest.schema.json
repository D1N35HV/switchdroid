{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SwitchDroid Hub addon manifest (format_version 1)",
  "type": "object",
  "required": ["format_version", "game_id", "name", "version", "build_ids", "author", "romfs_validator"],
  "additionalProperties": true,
  "properties": {
    "format_version": { "const": 1 },
    "game_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "build_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
    },
    "author": { "type": "string", "minLength": 1 },
    "min_hub_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "description": "SPDX identifier of the addon's own files" },
    "upstream": {
      "type": "array",
      "description": "Community projects this addon builds on, for credit and license tracking",
      "items": {
        "type": "object",
        "required": ["name", "url", "license"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "storage_mb": { "type": "integer", "minimum": 1 },
        "recommended_ram_gb": { "type": "integer", "minimum": 1 },
        "supported_architectures": { "type": "array", "items": { "enum": ["arm64-v8a"] } }
      }
    },
    "runtime_config": {
      "type": "object",
      "properties": {
        "base_resolution": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
        "default_orientation": { "type": "string" },
        "frame_rate_target": { "type": "integer", "minimum": 1, "maximum": 240 },
        "frame_generation_supported": { "type": "boolean" },
        "recommended_gpu_driver": { "type": "string" },
        "memory_pool_mb": { "type": "integer", "minimum": 1 }
      }
    },
    "romfs_validator": {
      "type": "object",
      "required": ["critical_files", "min_file_count"],
      "properties": {
        "critical_files": { "type": "array", "items": { "type": "string" } },
        "min_file_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
